<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Gran Villagio Mini Bar</title><style>
:root{--navy:#071d3b;--navy2:#0d2d55;--gold:#d8b46a;--bg:#f4f7fb;--text:#172033;--muted:#687386;--green:#1f9d62;--red:#c73b45;--yellow:#d9a516;--purple:#7656b8;--blue:#2676d8;--orange:#e17d22;--white:#fff;--shadow:0 8px 25px #071d3b16}*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}.top{background:linear-gradient(135deg,var(--navy),var(--navy2));color:white;padding:14px 18px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:5}.logo{width:165px;max-height:42px;object-fit:contain;object-position:left}.top h1{font-size:18px;margin:0}.top small{display:block;opacity:.7;margin-top:3px}.wrap{max-width:1250px;margin:auto;padding:18px}.login{max-width:600px;margin:60px auto;background:#fff;border-radius:20px;padding:28px;box-shadow:var(--shadow)}.login img{width:210px;background:var(--navy);padding:14px;border-radius:12px}.roles{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:20px}.role{padding:18px;border-radius:14px;background:#f1f5fa;border:1px solid #e2e8f0;text-align:left}.role b{display:block;font-size:16px}.role span{font-size:12px;color:var(--muted)}.staffs{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.staffs button{background:var(--navy);color:#fff;padding:10px 13px;border-radius:10px}.hidden{display:none!important}.nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.nav button{background:#fff;border:1px solid #dbe2eb;color:var(--navy);padding:10px 13px;border-radius:10px}.nav button.active{background:var(--navy);color:#fff}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card{background:#fff;border-radius:16px;padding:16px;box-shadow:var(--shadow)}.metric{font-size:27px;font-weight:700;margin-top:6px}.muted{color:var(--muted);font-size:13px}.section{margin-bottom:16px}.form{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.form .wide{grid-column:span 2}.form input,.form select,.form textarea{width:100%;padding:11px;border:1px solid #d8e0ea;border-radius:10px;background:#fff}.form textarea{min-height:70px}.primary{background:var(--navy);color:#fff;padding:11px 15px;border-radius:10px}.danger{background:var(--red);color:#fff;padding:10px 12px;border-radius:9px}.success{background:var(--green);color:#fff;padding:10px 12px;border-radius:9px}.tag{display:inline-block;padding:5px 8px;border-radius:999px;color:#fff;font-size:11px;font-weight:700}.t-red{background:var(--red)}.t-yellow{background:var(--yellow)}.t-purple{background:var(--purple)}.t-blue{background:var(--blue)}.t-green{background:var(--green)}.t-orange{background:var(--orange)}.list{display:flex;flex-direction:column;gap:10px}.item{background:#fff;border-radius:14px;padding:13px;box-shadow:var(--shadow);display:flex;justify-content:space-between;gap:10px;align-items:center}.item .actions{display:flex;gap:6px;flex-wrap:wrap}.toast{position:fixed;right:18px;bottom:18px;background:var(--navy);color:#fff;padding:14px 16px;border-radius:12px;box-shadow:var(--shadow);display:none;z-index:20}.pin{max-width:330px}.modal{position:fixed;inset:0;background:#0008;display:flex;align-items:center;justify-content:center;z-index:15}.modal>div{background:#fff;border-radius:18px;padding:24px;width:min(420px,92vw)}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.form{grid-template-columns:1fr 1fr}.form .wide{grid-column:span 2}.top{position:static}.wrap{padding:12px}}@media(max-width:520px){.grid{grid-template-columns:1fr 1fr}.roles{grid-template-columns:1fr}.form{grid-template-columns:1fr}.form .wide{grid-column:span 1}.item{align-items:flex-start;flex-direction:column}.item .actions{width:100%}.item .actions button{flex:1}.logo{width:135px}}
</style></head><body>
<div id="login" class="login"><img src="/logo-gran-villagio-branca.png"><h2>Gran Villagio Mini Bar</h2><p class="muted">Selecione o setor para entrar. As senhas dos setores, quando configuradas, são definidas pelo supervisor.</p><div class="roles"><button class="role" onclick="enter('Recepção')"><b>Recepção</b><span>Entrada direta</span></button><button class="role" onclick="enter('Governança')"><b>Governança</b><span>Acesso compartilhado</span></button><button class="role" onclick="enter('Gerência')"><b>Gerência</b><span>Acesso compartilhado</span></button><button class="role" onclick="enter('Mini Bar')"><b>Mini Bar</b><span>Selecionar funcionário</span></button></div><p style="margin-top:18px"><button class="primary" onclick="adminLogin()">Administração Antonio</button></p></div>
<div id="app" class="hidden"><header class="top"><img class="logo" src="/logo-gran-villagio-branca.png"><div><h1>Gran Villagio Mini Bar</h1><small id="who"></small></div><div style="margin-left:auto"><button class="navbtn" onclick="logout()">Sair</button></div></header><main class="wrap"><div id="nav" class="nav"></div><div id="content"></div></main></div><div id="toast" class="toast"></div>
<script>
let state={sector:'',user:'',rooms:[],products:[],staff:[],tab:'inicio',adminToken:''};const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
async function api(url,opt={}){const headers={'Content-Type':'application/json',...(opt.headers||{})};if(state.adminToken)headers['x-admin-token']=state.adminToken;const r=await fetch(url,{headers,...opt});const j=await r.json();if(!r.ok)throw new Error(j.error||'Erro');return j}
function beep(){try{const A=window.AudioContext||window.webkitAudioContext;if(!A)return;const a=new A();const o=a.createOscillator(),g=a.createGain();o.frequency.value=880;g.gain.value=.06;o.connect(g);g.connect(a.destination);o.start();o.stop(a.currentTime+.18)}catch{}}function toast(t){const x=$('toast');x.textContent=t;x.style.display='block';beep();setTimeout(()=>x.style.display='none',3200)}
async function enter(sector){if(sector==='Mini Bar'){state.sector=sector;const staff=state.staff.filter(x=>x.sector==='Mini Bar');return chooseStaff(staff)} if(['Recepção','Governança','Gerência'].includes(sector)){const pass=prompt('Digite a senha de '+sector+'.\n\nSe o supervisor ainda não cadastrou uma senha, deixe em branco.');if(pass===null)return;try{const r=await api('/api/sector/verify',{method:'POST',body:JSON.stringify({sector,password:pass})});if(!r.ok)return toast('Senha incorreta');state.sector=sector;state.user=sector;showApp()}catch(e){toast(e.message)}return}state.sector=sector;state.user=sector;showApp()}
function chooseStaff(list){$('login').innerHTML='<img src="/logo-gran-villagio-branca.png"><h2>Mini Bar</h2><p class="muted">Selecione seu nome</p><div class="staffs">'+list.map(x=>`<button onclick="state.user='${esc(x.name)}';showApp()">${esc(x.name)}</button>`).join('')+'</div><p style="margin-top:18px"><button class="navbtn" onclick="location.reload()">Voltar</button></p>'}
function showApp(){ $('login').classList.add('hidden');$('app').classList.remove('hidden');$('who').textContent=`${state.sector} • ${state.user}`;buildNav();render();subscribe()}
function buildNav(){let tabs=['inicio'];if(state.sector==='Recepção')tabs.push('solicitacoes','conferencia','prorrogacoes','nao-reconhecido');if(state.sector==='Mini Bar')tabs.push('fila','conferencias','ocorrencias','perdas');if(state.sector==='Governança')tabs.push('ocorrencias');if(state.sector==='Gerência')tabs.push('dashboard','perdas','historico');if(state.sector==='Admin')tabs.push('dashboard','perdas','equipe','config');$('nav').innerHTML=tabs.map(t=>`<button class="${state.tab===t?'active':''}" onclick="state.tab='${t}';render()">${label(t)}</button>`).join('')}
function label(t){return {inicio:'Início',solicitacoes:'Solicitações',conferencia:'Conferir minibar',prorrogacoes:'Prorrogações','nao-reconhecido':'Não reconhecido',fila:'Fila do Mini Bar',conferencias:'Conferências',ocorrencias:'Acesso aos quartos',perdas:'Controle de perdas',dashboard:'Dashboard',historico:'Histórico',equipe:'Equipe',config:'Configurações'}[t]||t}
async function render(){try{const d=await api('/api/dashboard');let h='';if(state.tab==='inicio')h=home(d);if(state.tab==='solicitacoes')h=requestForm();if(state.tab==='conferencia')h=conferenceRequestForm();if(state.tab==='prorrogacoes')h=extensionForm();if(state.tab==='nao-reconhecido')h=nonRecognizedForm();if(state.tab==='fila')h=await requestList(true);if(state.tab==='conferencias')h=await conferenceList();if(state.tab==='ocorrencias')h=await occurrenceView();if(state.tab==='perdas')h=await lossView();if(state.tab==='dashboard')h=dashboardView(d);if(state.tab==='historico')h=await historyView();if(state.tab==='equipe')h=teamView();if(state.tab==='config')h=configView();$('content').innerHTML=h;wire();}catch(e){$('content').innerHTML='<div class="card">Erro ao carregar: '+esc(e.message)+'</div>'}}
function home(d){let cards='';if(state.sector==='Recepção')cards=`<div class="grid"><div class="card"><span class="muted">Solicitações pendentes</span><div class="metric">${d.pendingRequests}</div></div><div class="card"><span class="muted">Conferências pendentes</span><div class="metric">—</div></div></div>`;else if(state.sector==='Governança')cards=`<div class="grid"><div class="card"><span class="muted">Ocorrências abertas</span><div class="metric">${d.pendingOccurrences}</div></div></div>`;else cards=`<div class="grid"><div class="card"><span class="muted">Solicitações pendentes</span><div class="metric">${d.pendingRequests}</div></div><div class="card"><span class="muted">Ocorrências abertas</span><div class="metric">${d.pendingOccurrences}</div></div><div class="card"><span class="muted">Perdas hoje</span><div class="metric">${d.lossesToday}</div></div><div class="card"><span class="muted">Valor de perdas</span><div class="metric">R$ ${d.totalLoss.toFixed(2).replace('.',',')}</div></div></div>`;return cards+`<div class="card section" style="margin-top:16px"><h2>Bem-vindo, ${esc(state.user)}</h2><p class="muted">Sistema local do Gran Villagio. As informações ficam nesta máquina e podem ser compartilhadas pela rede local do hotel.</p></div>`}
function roomSelect(id='room'){return `<select id="${id}"><option value="">Apartamento</option>${state.rooms.map(r=>`<option>${r}</option>`).join('')}</select>`}
function conferenceRequestForm(){return `<div class="card"><h2>Solicitar conferência de minibar</h2><p class="muted">A recepção solicita; o Mini Bar confere e devolve os itens consumidos e o valor.</p><div class="form"><div>${roomSelect()}</div><div><select id="operation"><option>Check-out — conferir minibar</option><option>Liberar hóspede + solicitar conferência</option><option>Check-in — estabelecer quantidade inicial</option><option>Conferência</option></select></div><div class="wide"><input id="cnote" placeholder="Observação"></div></div><button class="primary" onclick="createConference()">Solicitar ao Mini Bar</button></div>`}
async function createConference(){try{await api('/api/conferences',{method:'POST',body:JSON.stringify({room:$('room').value,operation:$('operation').value,note:$('cnote').value,requester:state.user})});toast('Conferência enviada ao Mini Bar');render()}catch(e){toast(e.message)}}
async function conferenceList(){const arr=await api('/api/conferences');return `<div class="card"><h2>Fila de conferências</h2><div class="list" style="margin-top:12px">${arr.map(x=>`<div class="item"><div><b>Apto ${x.room}</b> • ${x.operation}<br><span class="muted">${x.requester} • ${new Date(x.createdAt).toLocaleString('pt-BR')} • ${x.note||''}</span><br>${x.items?.length?x.items.map(i=>`${i.qty}x ${i.name}`).join(' • '):'Sem itens lançados ainda'}</div><div class="actions">${x.status==='pendente'?`<button class="primary" onclick="openConference(${x.id})">CONFERIR</button>`:''}<span class="tag ${x.status==='concluida'?'t-green':x.status==='divergencia'?'t-red':'t-yellow'}">${x.status}</span></div></div>`).join('')||'<p class="muted">Nenhuma conferência.</p>'}</div></div>`}
async function openConference(id){const arr=await api('/api/conferences');const x=arr.find(a=>a.id===id);if(!x)return;let items=x.items||[];$('content').innerHTML=`<div class="card"><h2>Conferência • Apto ${x.room}</h2><p class="muted">${x.operation}</p><div class="list">${state.products.map((p,i)=>{const q=(items.find(a=>a.name===p.name)||{}).qty||0;return `<div class="item"><div><b>${p.name}</b><br><span class="muted">R$ ${p.price.toFixed(2).replace('.',',')}</span></div><div class="actions"><button class="navbtn" onclick="changeItem(${id},${i},-1)">−</button><b id="q${i}">${q}</b><button class="navbtn" onclick="changeItem(${id},${i},1)">+</button></div></div>`}).join('')}</div><button class="success" style="margin-top:14px" onclick="finishConference(${id})">ENVIAR RESULTADO</button></div>`}
async function changeItem(id,i,delta){const arr=await api('/api/conferences');const x=arr.find(a=>a.id===id);let items=x.items||[];let row=items.find(a=>a.name===state.products[i].name);if(!row){row={name:state.products[i].name,price:state.products[i].price,qty:0};items.push(row)}row.qty=Math.max(0,(row.qty||0)+delta);items=items.filter(a=>a.qty>0);await api('/api/conferences/'+id,{method:'PATCH',body:JSON.stringify({items,assignee:state.user,status:'em andamento'})});openConference(id)}
async function finishConference(id){const arr=await api('/api/conferences');const x=arr.find(a=>a.id===id);const total=(x.items||[]).reduce((s,i)=>s+i.qty*i.price,0);await api('/api/conferences/'+id,{method:'PATCH',body:JSON.stringify({items:x.items,status:'concluida',assignee:state.user})});toast(`Conferência concluída • R$ ${total.toFixed(2).replace('.',',')}`);render()}
function nonRecognizedForm(){return `<div class="card"><h2>Não reconhecido pelo hóspede</h2><p class="muted">Área exclusiva da Recepção para registrar uma contestação de cobrança de minibar.</p><div class="form"><div>${roomSelect()}</div><div class="wide"><input id="prod" placeholder="Produto contestado"></div><div class="wide"><textarea id="lnote" placeholder="Observação"></textarea></div></div><button class="danger" onclick="createNonRecognized()">REGISTRAR NÃO RECONHECIDO</button></div>`}
async function createNonRecognized(){try{await api('/api/losses',{method:'POST',body:JSON.stringify({type:'Não Reconhecido',room:$('room').value,product:$('prod').value,quantity:1,unitPrice:0,note:$('lnote').value,responsible:state.user})});toast('Não reconhecido registrado');render()}catch(e){toast(e.message)}}
function requestForm(){return `<div class="card"><h2>Nova solicitação</h2><div class="form"><div>${roomSelect()}</div><div><select id="type"><option>Copos</option><option>Água</option><option>Refrigerante</option><option>Chocolate</option><option>Reposição de minibar</option><option>Outro item</option></select></div><div><input id="qty" type="number" min="1" value="1" placeholder="Quantidade"></div><div><select id="priority"><option value="normal">Solicitação comum</option><option value="prioridade">Prioridade</option><option value="urgente">Urgente</option></select></div><div class="wide"><textarea id="note" placeholder="Observação"></textarea></div></div><button class="primary" onclick="createRequest()">Enviar para o Mini Bar</button></div><div class="card" style="margin-top:16px"><h3>Atalhos</h3><p class="muted">Para urgências, selecione a prioridade. O Mini Bar receberá uma notificação na hora.</p></div>`}
async function createRequest(){try{await api('/api/requests',{method:'POST',body:JSON.stringify({kind:'operacional',room:$('room').value,type:$('type').value,quantity:$('qty').value,priority:$('priority').value,note:$('note').value,requester:state.user})});toast('Solicitação enviada ao Mini Bar');render()}catch(e){toast(e.message)}}
function extensionForm(){return `<div class="card"><h2>Prorrogação de hospedagem</h2><p class="muted">Informe ao Mini Bar os quartos que prorrogaram a hospedagem hoje.</p><div class="form"><div>${roomSelect()}</div><div><input id="newDate" type="date"></div><div class="wide"><input id="note" placeholder="Observação"></div></div><button class="primary" onclick="createExtension()">Registrar prorrogação</button></div><div class="card" style="margin-top:16px"><h3>Prorrogações recentes</h3><div id="extList">Carregando...</div></div>`}
async function createExtension(){try{await api('/api/extensions',{method:'POST',body:JSON.stringify({room:$('room').value,newDate:$('newDate').value,note:$('note').value,requester:state.user})});toast('Prorrogação enviada ao Mini Bar');render()}catch(e){toast(e.message)}}
async function requestList(mini){const arr=await api('/api/requests');let data=mini?arr:arr.filter(x=>x.requester===state.user);return `<div class="card"><h2>${mini?'Fila do Mini Bar':'Solicitações'}</h2><div class="list" style="margin-top:12px">${data.map(x=>`<div class="item"><div><b>Apto ${esc(x.room||'—')}</b> • ${esc(x.type)} <span class="tag ${x.priority==='urgente'?'t-red':x.priority==='prioridade'?'t-orange':'t-blue'}">${esc(x.priority)}</span><br><span class="muted">${esc(x.requester)} • ${new Date(x.createdAt).toLocaleString('pt-BR')} • ${esc(x.note)}</span></div><div class="actions">${mini?`<button class="primary" onclick="reqStatus(${x.id},'em atendimento','${esc(state.user)}')">ASSUMIR</button><button class="success" onclick="reqStatus(${x.id},'concluida','${esc(state.user)}')">CONCLUÍDO</button>`:`<span class="tag ${x.status==='concluida'?'t-green':'t-yellow'}">${esc(x.status)}</span>`}</div></div>`).join('')||'<p class="muted">Nenhuma solicitação.</p>'}</div></div>`}
async function reqStatus(id,status,user){try{await api('/api/requests/'+id,{method:'PATCH',body:JSON.stringify({status,assignee:user})});toast('Atualizado');render()}catch(e){toast(e.message)}}
async function occurrenceView(){const arr=await api('/api/occurrences');let h='';if(state.sector==='Mini Bar')h+=`<div class="card section"><h2>Informar problema de acesso</h2><div class="form"><div>${roomSelect()}</div><div><select id="otype"><option>NÃO PERTURBE</option><option>NÃO DEIXOU ENTRAR</option></select></div></div><button class="primary" onclick="createOcc()">Enviar para Governança</button></div>`;h+=`<div class="card"><h2>Ocorrências</h2><div class="list" style="margin-top:12px">${arr.map(x=>`<div class="item"><div><b>Apto ${x.room}</b> <span class="tag ${x.type==='NÃO PERTURBE'?'t-purple':'t-yellow'}">${x.type}</span><br><span class="muted">${new Date(x.createdAt).toLocaleString('pt-BR')} • ${x.reportedBy}</span></div><div class="actions">${state.sector==='Governança'&&x.status!=='deu certo'&&x.status!=='não deu certo'?`<button class="primary" onclick="occStatus(${x.id},'tentar novamente')">TENTAR NOVAMENTE</button>`:''}${state.sector==='Mini Bar'&&x.status==='tentar novamente'?`<button class="success" onclick="occStatus(${x.id},'deu certo')">DEU CERTO</button><button class="danger" onclick="occStatus(${x.id},'não deu certo')">NÃO DEU CERTO</button>`:''}<span class="tag ${x.status==='deu certo'?'t-green':x.status==='não deu certo'?'t-red':x.status==='tentar novamente'?'t-blue':'t-orange'}">${x.status}</span></div></div>`).join('')||'<p class="muted">Nenhuma ocorrência.</p>'}</div></div>`;return h}
async function createOcc(){try{await api('/api/occurrences',{method:'POST',body:JSON.stringify({room:$('room').value,type:$('otype').value,reportedBy:state.user})});toast('Governança foi notificada');render()}catch(e){toast(e.message)}}
async function occStatus(id,status){try{await api('/api/occurrences/'+id,{method:'PATCH',body:JSON.stringify({status})});toast('Status atualizado');render()}catch(e){toast(e.message)}}
async function lossView(){const arr=await api('/api/losses');let h='';if(state.sector==='Mini Bar'||state.sector==='Recepção'||state.sector==='Admin')h+=`<div class="card section"><h2>Registrar perda</h2><div class="form"><div><select id="ltype">${state.sector==='Recepção'?'<option>Não Reconhecido</option>':'<option>Quebra</option><option>Não Conferido</option>'}${state.sector==='Admin'?'<option>Não Reconhecido</option>':''}</select></div><div>${roomSelect('lroom')}</div><div><select id="prod">${state.products.map(p=>`<option value="${p.price}">${p.name} — R$ ${p.price.toFixed(2).replace('.',',')}</option>`).join('')}</select></div><div><input id="lqty" type="number" min="1" value="1"></div><div class="wide"><input id="lnote" placeholder="Observação"></div></div><button class="primary" onclick="createLoss()">Registrar ocorrência</button></div>`;if(state.sector==='Recepção')return h;return h+`<div class="card"><h2>Histórico de perdas</h2><div class="list" style="margin-top:12px">${arr.map(x=>`<div class="item"><div><b>${x.type}</b> • Apto ${x.room||'—'} • ${x.product||'—'}<br><span class="muted">${new Date(x.createdAt).toLocaleString('pt-BR')} • ${x.responsible||''}</span></div><strong>R$ ${(x.quantity*x.unitPrice).toFixed(2).replace('.',',')}</strong></div>`).join('')||'<p class="muted">Nenhuma perda.</p>'}</div></div>`}
async function createLoss(){try{const sel=$('prod');await api('/api/losses',{method:'POST',body:JSON.stringify({type:$('ltype').value,room:$('lroom').value,product:sel.options[sel.selectedIndex].text,quantity:$('lqty').value,unitPrice:sel.value,note:$('lnote').value,responsible:state.user})});toast('Perda registrada');render()}catch(e){toast(e.message)}}
function dashboardView(d){return `<div class="grid"><div class="card"><span class="muted">Quebras / perdas hoje</span><div class="metric">${d.lossesToday}</div></div><div class="card"><span class="muted">Valor total</span><div class="metric">R$ ${d.totalLoss.toFixed(2).replace('.',',')}</div></div><div class="card"><span class="muted">Solicitações abertas</span><div class="metric">${d.pendingRequests}</div></div><div class="card"><span class="muted">Acessos pendentes</span><div class="metric">${d.pendingOccurrences}</div></div></div><div class="card" style="margin-top:16px"><h2>Resumo do dia</h2><p class="muted">O dashboard consolida solicitações, ocorrências e perdas. Os detalhes permanecem disponíveis nas áreas específicas.</p></div>`}
async function historyView(){const [r,o,e,l]=await Promise.all([api('/api/requests'),api('/api/occurrences'),api('/api/extensions'),api('/api/losses')]);return `<div class="grid"><div class="card"><b>${r.length}</b><br><span class="muted">Solicitações</span></div><div class="card"><b>${o.length}</b><br><span class="muted">Ocorrências de acesso</span></div><div class="card"><b>${e.length}</b><br><span class="muted">Prorrogações</span></div><div class="card"><b>${l.length}</b><br><span class="muted">Perdas registradas</span></div></div><div class="card" style="margin-top:16px"><h2>Auditoria</h2><p class="muted">Registros preservam data e hora das operações.</p></div>`}
function teamView(){const arr=state.staff;return `<div class="card"><h2>Equipe</h2><div class="form"><input id="sname" placeholder="Nome"><select id="ssector"><option>Recepção</option><option>Governança</option><option>Gerência</option><option>Mini Bar</option></select><button class="primary" onclick="addStaff()">Adicionar</button></div><div class="list" style="margin-top:16px">${arr.map(x=>`<div class="item"><b>${x.name}</b><span class="muted">${x.sector}</span></div>`).join('')}</div></div>`}
async function addStaff(){try{await api('/api/staff',{method:'POST',body:JSON.stringify({name:$('sname').value,sector:$('ssector').value})});const b=await api('/api/bootstrap');state.staff=b.staff;toast('Funcionário adicionado');render()}catch(e){toast(e.message)}}
function configView(){return `<div class="card"><h2>Administração</h2><p class="muted">Controle exclusivo do Antonio.</p><div class="card" style="box-shadow:none;border:1px solid #e5eaf1;margin:14px 0"><h3>PIN do Antonio</h3><input id="oldpin" type="password" placeholder="PIN atual"><br><br><input id="newpin" type="password" placeholder="Novo PIN"><br><br><button class="primary" onclick="changePin()">Alterar PIN</button></div><div class="card" style="box-shadow:none;border:1px solid #e5eaf1"><h3>Senhas dos setores</h3><p class="muted">Você pode criar, trocar ou remover a senha de Recepção, Governança e Gerência. Deixe em branco para manter a entrada direta.</p><div class="form"><select id="pssector"><option>Recepção</option><option>Governança</option><option>Gerência</option></select><input id="pspass" type="password" placeholder="Nova senha (mín. 4 caracteres)"><button class="primary" onclick="saveSectorPassword()">Salvar senha</button></div><div id="psstatus" class="muted" style="margin-top:12px">Carregando status...</div></div></div>`}
async function changePin(){try{await api('/api/admin/pin',{method:'POST',body:JSON.stringify({currentPin:$('oldpin').value,newPin:$('newpin').value})});toast('PIN alterado');render()}catch(e){toast(e.message)}}
async function saveSectorPassword(){try{const sector=$('pssector').value;const password=$('pspass').value;await api('/api/admin/sector-passwords',{method:'POST',body:JSON.stringify({sector,password})});toast(password?'Senha de '+sector+' salva.':'Senha de '+sector+' removida; acesso direto.');render()}catch(e){toast(e.message)}}
async function loadSectorPasswordStatus(){if(state.sector!=='Admin'||state.tab!=='config')return;try{const r=await api('/api/admin/sector-passwords');$('psstatus').innerHTML=r.sectors.map(x=>`${esc(x.sector)}: <b>${x.configured?'senha configurada':'sem senha (entrada direta)'}</b>`).join(' &nbsp;•&nbsp; ')}catch(e){$('psstatus').textContent=e.message}}
async function adminLogin(){const pin=prompt('Digite o PIN da Administração Antonio:');if(pin===null)return;try{const r=await api('/api/admin/verify',{method:'POST',body:JSON.stringify({pin})});if(!r.ok)return toast('PIN inválido');state.adminToken=r.token;state.sector='Admin';state.user='Antonio';state.tab='dashboard';showApp()}catch(e){toast(e.message)}}
function logout(){location.reload()}
function subscribe(){const es=new EventSource('/api/events?sector='+encodeURIComponent(state.sector));es.onmessage=e=>{try{const x=JSON.parse(e.data);toast(x.title+' • '+x.message);if(state.tab!=='config')render()}catch{}}}
function wire(){if(state.sector==='Admin'&&state.tab==='config')setTimeout(loadSectorPasswordStatus,0)}
(async()=>{try{const b=await api('/api/bootstrap');state.rooms=b.rooms;state.products=b.products;state.staff=b.staff;}catch(e){console.error(e)}})();
</script></body></html>
